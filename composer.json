{
    "name": "baueri/mint-template",
    "type": "library",
    "description": "A tiny PHP template compiler with DOM and @-directives.",
    "license": "MIT",
    "keywords": [
        "php",
        "template",
        "view",
        "compiler",
        "dom"
    ],
    "autoload": {
        "psr-4": {
            "Baueri\\Mint\\": "src/View/"
        },
        "files": [
            "src/View/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Baueri\\Mint\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Ivan Bauer",
            "email": "ivan.bauer90@gmail.com"
        }
    ],
    "bin": [
        "bin/mint"
    ],
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
